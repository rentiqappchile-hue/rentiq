rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Documento raíz del usuario: contiene `pro` y `suscripcion`.
    // El cliente solo puede LEER su propio documento. Las escrituras
    // (activar/desactivar Pro) las hacen exclusivamente las Cloud
    // Functions vía Admin SDK, que no pasa por estas reglas.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      // Propiedades del usuario: CRUD completo solo para el dueño.
      match /deptos/{deptoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Códigos de acceso: solo los manipula el Admin SDK (canjearCodigo).
    match /codigosAcceso/{codigo} {
      allow read, write: if false;
    }
  }
}
